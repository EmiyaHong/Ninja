node_modules/
__pycache__/
*.pyc
*.log
*.tmp
*.bak
*.zip
*.7z
*.exe
*.msi
/.tmp/
/tmp/
/build/
/dist/
/export_templates/
Thumbs.db
.DS_Store
# Assistant-local working notes, not required art sources.
.workbuddy/
